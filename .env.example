# Copy this file to .env.local and fill in credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# SMTP is used for support, grievance, and partner enquiry notifications.
# Waitlist signups are stored in PostgreSQL and are not emailed to an inbox.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Ampza Website <verified-sender@example.com>"
